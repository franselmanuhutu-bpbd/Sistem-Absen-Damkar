{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "notification:default",
    "dialog:default",
    "fs:default",
    "fs:allow-write-file",
    "fs:allow-mkdir",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://sistem-absen-damkar.vercel.app/*" },
        { "url": "https://*.vercel.app/*" },
        { "url": "https://*.supabase.co/*" },
        { "url": "http://localhost:*/*" },
        { "url": "http://127.0.0.1:*/*" }
      ]
    }
  ]
}